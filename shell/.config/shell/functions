# Cheat sheet of tmux shortcuts, from the -N notes in ~/.tmux.conf
function keys() {
  echo "Anywhere"
  tmux start-server \; list-keys -N -T root | sed 's/^M-/  ⌥ /'
  echo "Copy mode (scroll up, or Ctrl-b [)"
  tmux start-server \; list-keys -N -T copy-mode-vi | sed 's/^/  /'
}

# Upgrade everything: system packages, mise and its tools, Neovim plugins and Mason tools
function update() {
  if command -v brew &>/dev/null; then
    brew update && brew upgrade
  elif command -v apt &>/dev/null; then
    sudo apt update && sudo apt upgrade -y && mise self-update --yes
  else
    sudo dnf upgrade -y && mise self-update --yes
  fi
  mise upgrade
  nvim --headless "+Lazy! sync" +qa
  nvim --headless +MasonToolsUpdateSync +qa
}
