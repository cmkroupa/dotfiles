alias ..='cd ..'
alias ...='cd ../..'
command -v eza &>/dev/null && alias ls='eza --icons --group-directories-first'
command -v eza &>/dev/null && alias ll='eza -la --icons --group-directories-first --git'
cat() {
  if [[ $# -eq 1 && "$1" == *.md ]] && command -v glow &>/dev/null; then
    glow "$1"
  elif command -v bat &>/dev/null; then
    bat --paging=never "$@"
  else
    command cat "$@"
  fi
}
alias v='nvim'
alias g='git'
alias gst='git status'
alias gcm='git commit -m'
alias gph='git push'
alias gsw='git switch'
alias rg='rg --smart-case'
alias path='echo $PATH | tr ":" "\n"'

glg() { git log --oneline --graph --decorate -${1:-20}; }
mkcd() { mkdir -p "$1" && cd "$1"; }
reload() {
  [[ -n "$ZSH_VERSION" ]]  && source ~/.zshrc  && return
  [[ -n "$BASH_VERSION" ]] && source ~/.bashrc && return
}
lspinit() {
  command -v compiledb &>/dev/null && command -v jq &>/dev/null || { echo "requires compiledb and jq"; return 1; }
  local root; root=$(git -C "${1:-.}" rev-parse --show-toplevel 2>/dev/null) || root="${1:-.}"
  local tmp_files=()
  while IFS= read -r dir; do
    local tmp; tmp=$(mktemp /tmp/ccXXXXXX.json)
    (cd "$dir" && compiledb -f -o "$tmp" make -n -k 2>/dev/null) && [[ -s "$tmp" ]] \
      && tmp_files+=("$tmp") || rm -f "$tmp"
  done < <(find "$root" -maxdepth 2 -name "[Mm]akefile" -not -path "*/build/*" -printf "%h\n" | sort -u)
  [[ ${#tmp_files[@]} -eq 0 ]] && { echo "no compile_commands.json generated"; return 1; }
  jq -s 'add | unique_by(.file)' "${tmp_files[@]}" > "$root/compile_commands.json"
  rm -f "${tmp_files[@]}"
  echo "written to $root/compile_commands.json"
}
