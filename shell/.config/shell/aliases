alias godot='cd ~/dotfiles'
alias ..='cd ..'
alias ...='cd ../..'
command -v eza &>/dev/null && alias ls='eza --icons --group-directories-first'
command -v eza &>/dev/null && alias ll='eza -la --icons --group-directories-first --git'
function cat() {
  if [[ $# -eq 1 && "$1" == *.md ]] && command -v glow &>/dev/null; then
    glow "$1"
  elif command -v bat &>/dev/null; then
    bat --paging=never "$@"
  else
    command cat "$@"
  fi
}
alias v='nvim'
alias g='git'
alias gst='git status'
alias gcm='git commit -m'
alias gph='git push'
alias gsw='git switch'
alias rg='rg --smart-case'
alias path='echo $PATH | tr ":" "\n"'

function glg() { git log --oneline --graph --decorate -${1:-20}; }
function mkcd() { mkdir -p "$1" && cd "$1"; }
function reload() {
  [[ -n "$ZSH_VERSION" ]]  && source ~/.zshrc  && return
  [[ -n "$BASH_VERSION" ]] && source ~/.bashrc && return
}
uncrust() {
  [[ $# -eq 0 ]] && { echo "usage: uncrust <file>"; return 1; }
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/uncrustify/core-uncrustify.cfg"
  [[ -f "$cfg" ]] || { echo "uncrust: config not found: $cfg"; return 1; }
  for f in "$@"; do
    local ext="${f##*.}"
    case "$ext" in
      c|h)             local lang=C ;;
      cpp|hpp|tcc|ipp) local lang=CPP ;;
      *) echo "uncrust: unsupported extension: $f"; continue ;;
    esac
    uncrustify -c "$cfg" -l "$lang" --no-backup "$f" && echo "formatted: $f"
  done
}
