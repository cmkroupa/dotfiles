# ── C/C++ ─────────────────────────────────────────────────────────────────────
# Initialise clangd LSP: generates compile_commands.json via dry-run (no actual build needed).
# Usage: lspinit [path]   defaults to current directory
lspinit() { # Generate Clangd compile_commands.json from Makefile
  local dir="${1:-.}"
  if ! command -v compiledb &>/dev/null; then
    echo -e "\033[1;31mError: 'compiledb' utility is not installed.\033[0m"
    echo -e "Clangd C/C++ LSP requires a \033[1;33mcompile_commands.json\033[0m file at your project root to find headers and compilation flags."
    echo -e "To automatically generate it from your Makefile, please install compiledb:"
    echo -e "  \033[1;32mpip install compiledb\033[0m"
    echo -e "Alternatively, you can generate it using Bear: \033[1;32mbear -- make\033[0m"
    return 1
  fi
  echo -e "\033[1;34m==> Generating compile_commands.json inside: $dir\033[0m"
  (cd "$dir" && compiledb -n make -k -j8) && echo -e "  \033[1;32m[✔] compile_commands.json written successfully!\033[0m Clangd will pick it up on next Neovim open."
}

# ── Utilities ─────────────────────────────────────────────────────────────────
alias aliases='bash $DOTFILES/scripts/alias-help.sh'
alias theme='bash $DOTFILES/scripts/theme.sh'
alias path='echo $PATH | tr ":" "\n"'

mkcd() { # Create and enter a new directory
  mkdir -p "$1" && cd "$1";
}
weather() { # Get weather forecast by city
  curl "wttr.in/${1:-Toronto}?format=3";
}
explain() { # Query cheat.sh community command sheets
  curl "cheat.sh/$1";
}
pword() { # Generate a secure random password
  LC_ALL=C tr -dc 'A-Za-z0-9!@#$%^&*' < /dev/urandom | command head -c ${1:-20}; echo;
}

reload() { # Reload active shell profile configurations
  [[ -n "$ZSH_VERSION" ]]  && source ~/.zshrc  && echo "zsh reloaded"  && return
  [[ -n "$BASH_VERSION" ]] && source ~/.bashrc && echo "bash reloaded" && return
  echo "unknown shell"
}

[[ -n "$BASH_VERSION" ]] && bind '"\e[A": history-search-backward'
[[ -n "$BASH_VERSION" ]] && bind '"\e[B": history-search-forward'
