# ── Navigation ────────────────────────────────────────────────────────────────
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias home='cd ~'
alias dotfiles='cd ~/dotfiles'

# ── Files ─────────────────────────────────────────────────────────────────────
alias ls='eza --icons --group-directories-first'
alias ll='eza -la --icons --group-directories-first --git'
alias cat='bat --paging=never'

head() {
    local n=10
    if [[ $1 == -n ]]; then n=$2; shift 2
    elif [[ $1 =~ ^-[0-9]+$ ]]; then n=${1#-}; shift
    fi
    bat --paging=never -r ":$n" "$@"
}

tail() {
    for arg in "$@"; do [[ $arg == -f ]] && { command tail "$@"; return; }; done
    local n=10
    if [[ $1 == -n ]]; then n=$2; shift 2
    elif [[ $1 =~ ^-[0-9]+$ ]]; then n=${1#-}; shift
    fi
    command tail -n "$n" "$@" | bat --paging=never --file-name="${@: -1}"
}

# ── Editor ────────────────────────────────────────────────────────────────────
alias v='nvim'

# ── Git ───────────────────────────────────────────────────────────────────────
alias g='git'
alias vgit='lazygit'
alias gst='git status'
alias gad='git add'
alias gcm='git commit -m'
alias gph='git push'
alias gfh='git fetch'
alias gbr='git branch'
alias gsw='git switch'

glg() { git log --oneline --graph --decorate -${1:-20}; }

# ── Search ────────────────────────────────────────────────────────────────────
alias rg='rg --smart-case'
alias rgf='rg --files | rg'

# ── C/C++ ─────────────────────────────────────────────────────────────────────
# Initialise clangd LSP: generates compile_commands.json via dry-run (no actual build needed).
# Usage: lspinit [path]   defaults to current directory
lspinit() {
  local dir="${1:-.}"
  (cd "$dir" && compiledb make -n) && echo "  compile_commands.json written to $dir — clangd will pick it up on next nvim open"
}

# ── Utilities ─────────────────────────────────────────────────────────────────
alias aliases='bash ~/dotfiles/scripts/alias-help.sh'
alias path='echo $PATH | tr ":" "\n"'

mkcd()   { mkdir -p "$1" && cd "$1"; }
weather(){ curl "wttr.in/${1:-Toronto}?format=3"; }
explain(){ curl "cheat.sh/$1"; }
pword()  { tr -dc 'A-Za-z0-9!@#$%^&*' < /dev/urandom | head -c ${1:-20}; echo; }

reload() {
  [[ -n "$ZSH_VERSION" ]]  && source ~/.zshrc  && echo "zsh reloaded"  && return
  [[ -n "$BASH_VERSION" ]] && source ~/.bashrc && echo "bash reloaded" && return
  echo "unknown shell"
}

[[ -n "$BASH_VERSION" ]] && bind '"\e[A": history-search-backward'
[[ -n "$BASH_VERSION" ]] && bind '"\e[B": history-search-forward'
