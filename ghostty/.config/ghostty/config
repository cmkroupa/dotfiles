# ── Ghostty Configuration ─────────────────────────────────────────────────────

# Import the active theme which is dynamically managed
config-file = active_theme

# Typography
font-family = "FiraCode Nerd Font"
font-size = 13.0
adjust-cell-height = 15%

# Window Aesthetics
window-padding-x = 12
window-padding-y = 12
background-opacity = 0.95
background-blur = 20

# Settings
confirm-close-surface = false
macos-option-as-alt = true
copy-on-select = true
