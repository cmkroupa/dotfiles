# ── Ghostty Configuration ─────────────────────────────────────────────────────

# Import the active theme which is dynamically managed
import active_theme

# Typography
font-family = "FiraCode Nerd Font"
font-size = 13.0
adjust-line-height = 15%

# Window Aesthetics
window-padding-x = 12
window-padding-y = 12
window-background-opacity = 0.95
window-background-blur = true
background-blur-radius = 20

# Settings
confirm-close-surface = false
macos-option-as-meta = true
copy-on-select = true
