# ── Ghostty Configuration ─────────────────────────────────────────────────────

theme = Catppuccin Macchiato
# login shell so tmux is found on PATH (Homebrew on macOS, /usr/bin on Ubuntu)
initial-command = /bin/zsh -lc tmux

# Typography
font-family = "FiraCode Nerd Font"
font-size = 13.0
adjust-cell-height = 15%

# Window Aesthetics
window-padding-x = 12
window-padding-y = 12
background-opacity = 0.95
background-blur = 20
macos-titlebar-style = hidden

# Settings
confirm-close-surface = false
macos-option-as-alt = true
copy-on-select = true

# Quick terminal: drops down from the top from any app (macOS asks for Accessibility permission once)
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# ⌥r reloads Ghostty too; unconsumed passes the key on so tmux still reloads itself and zsh
keybind = unconsumed:alt+r=reload_config
