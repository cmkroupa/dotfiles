# ── Utilities ─────────────────────────────────────────────────────────────────
alias path='echo $PATH | tr ":" "\n"'

mkcd()   { mkdir -p "$1" && cd "$1"; }
weather() { curl "wttr.in/${1:-Toronto}?format=3"; }
reload()  {
  [[ -n "$ZSH_VERSION" ]]  && source ~/.zshrc  && echo "reloaded" && return
  [[ -n "$BASH_VERSION" ]] && source ~/.bashrc && echo "reloaded" && return
}

# ── C/C++ clangd LSP ──────────────────────────────────────────────────────────
lspinit() {
  if ! command -v compiledb &>/dev/null || ! command -v jq &>/dev/null; then
    echo "Error: 'compiledb' and 'jq' are required."
    return 1
  fi
  local root
  root=$(git -C "${1:-.}" rev-parse --show-toplevel 2>/dev/null) || root="${1:-.}"
  local tmp_files=()
  while IFS= read -r dir; do
    local tmp; tmp=$(mktemp /tmp/ccXXXXXX.json)
    if (cd "$dir" && compiledb -f -o "$tmp" make -n -k 2>/dev/null) && [[ -s "$tmp" ]]; then
      tmp_files+=("$tmp"); echo "  ✔ $dir"
    else
      rm -f "$tmp"
    fi
  done < <(find "$root" -maxdepth 2 -name "[Mm]akefile" -not -path "*/build/*" -printf "%h\n" | sort -u)
  [[ ${#tmp_files[@]} -eq 0 ]] && echo "No compile_commands.json generated." && return 1
  jq -s 'add | unique_by(.file)' "${tmp_files[@]}" > "$root/compile_commands.json"
  rm -f "${tmp_files[@]}"
  echo "compile_commands.json written to $root"
}
